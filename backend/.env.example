# Exchange Gift System Environment Configuration

# Set to False in production
DEBUG=True

# Django Secret Key (generate a strong one for production)
SECRET_KEY=django-insecure-exchange-gift-system-production-secret-key-12345

# Allowed Hosts (comma-separated, e.g., yourdomain.com,localhost,127.0.0.1)
ALLOWED_HOSTS=*

# Database URL:
# For Local Development (leave commented or empty to use default db.sqlite3)
# DATABASE_URL=

# For Supabase PostgreSQL (Production):
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection URI
# Example:
# DATABASE_URL=postgresql://postgres.yourprojectref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
